# ═══════════════════════════════════════════════════════════
# Autonomous AI Software Factory — Environment Variables
# Copy to .env and fill in your values.
#
# Two deployment options for the factory itself:
#   LOCAL RACK:  docker compose -f infrastructure/docker-compose.local-rack.yml up -d
#   CLOUD VPS:   docker compose -f infrastructure/docker-compose.cloud.yml up -d
# ═══════════════════════════════════════════════════════════

# ── LLM Providers (API — used by L5+ agents, or all agents on cloud) ──
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
OPENAI_API_KEY=sk-your-key-here
GOOGLE_AI_API_KEY=your-google-ai-key
DEEPSEEK_API_KEY=your-deepseek-key
META_API_KEY=your-together-ai-key  # For hosted Llama models via Together.ai

# ── LLM Provider (Local Ollama — LOCAL RACK ONLY, $0 cost) ────────────
# Ollama runs on your rack's GPU. L3-L4 agents use this instead of API.
# Skip these if running on cloud VPS (no GPU).
# After setup, pull models:
#   docker exec factory-ollama ollama pull qwen2.5-coder:32b
#   docker exec factory-ollama ollama pull gemma3:27b
OLLAMA_HOST=http://factory-ollama:11434
OLLAMA_API_KEY=ollama-local

# ── CEO Communication Channels ─────────────────────────────
# Telegram (Primary — approvals, discussions, meetings)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz
TELEGRAM_CEO_CHAT_ID=123456789  # Your Telegram user ID

# WhatsApp (Optional secondary — via Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_CEO_PHONE=1234567890  # With country code, no +

# ── Infrastructure ─────────────────────────────────────────
# Git hosting — agents push code here. All optional, configured per project.
GITHUB_TOKEN=ghp_your-github-token           # GitHub (cloud)
GITLAB_TOKEN=glpat-your-gitlab-token         # GitLab (cloud or self-hosted)
GITEA_URL=http://localhost:3000              # Gitea (self-hosted, runs on your rack)
GITEA_TOKEN=your-gitea-token
DOCKER_HOST=unix:///var/run/docker.sock
VALKEY_URL=redis://factory-valkey:6379  # Valkey uses the same redis:// protocol
GATEWAY_TOKEN=generate-with-openssl-rand-hex-32
POSTGRES_PASSWORD=generate-a-strong-password

# ── Cloud VPS Only ─────────────────────────────────────────
# Set your domain (pointed to VPS IP via DNS A record)
# Skip if running on local rack.
FACTORY_DOMAIN=factory.yourdomain.com

# ── Cost Control ───────────────────────────────────────────
PHASE_BUDGET_LIMIT=50   # USD — notify CEO if any phase exceeds this
TOTAL_BUDGET_LIMIT=200  # USD — hard warning threshold
